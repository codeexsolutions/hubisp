{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "privacidade.synkisp.com.br" }],
      "destination": "/privacidade.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "privacidade.synkisp.com.br" }],
      "destination": "/privacidade.html"
    },
    {
      "source": "/p/:codigo",
      "destination": "/p.html"
    }
  ]
}
